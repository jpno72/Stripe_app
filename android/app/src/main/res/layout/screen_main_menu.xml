<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F4"
    android:paddingStart="7dp"
    android:paddingTop="8dp"
    android:paddingEnd="7dp"
    android:paddingBottom="8dp">

   <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_border"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="42dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingBottom="8dp">
        
        <LinearLayout
            android:id="@+id/mainMenuContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/mainMenuTitle"
                android:layout_width="wrap_content"
                android:layout_height="151dp"
                android:fontFamily="sans-serif-black"
                android:paddingBottom="20dp"
                android:text="Stripe Payments"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="50sp"
                android:textStyle="bold"
                android:typeface="serif" />

            <Button
                android:id="@+id/takePaymentButton"
                style="@style/StripePosButton"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Take Payment"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:visibility="visible" />

            <Button
                android:id="@+id/cartButton"
                style="@style/StripePosButton"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Cart (0)"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:visibility="visible" />

            <Button
                android:id="@+id/reportingButton"
                style="@style/StripePosButton"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Reporting"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:visibility="visible" />

            <Button
                android:id="@+id/recentTransactionsButton"
                style="@style/StripePosButton"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Recent App Transactions"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:visibility="visible" />

            <Button
                android:id="@+id/testingConfigurationButton"
                style="@style/StripePosButton"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Testing and Configuration"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:visibility="visible" />



        </LinearLayout>
    </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/mainBackendText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#555555"
                android:textSize="12sp"
                tools:text="Backend: http://10.0.2.2:3000" />

            <TextView
                android:id="@+id/mainStatusText"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="Ready"
                android:textColor="#000000"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
