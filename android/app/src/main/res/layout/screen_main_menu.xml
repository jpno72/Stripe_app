<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA"
    android:paddingStart="7dp"
    android:paddingTop="8dp"
    android:paddingEnd="7dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_border"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="42dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/mainMenuContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom|clip_horizontal|center|clip_vertical|start|right|center_horizontal|fill|fill_horizontal|top|left|center_vertical|fill_vertical|end"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/mainMenuTitle"
                    android:layout_width="297dp"
                    android:layout_height="wrap_content"
                    android:paddingBottom="20dp"
                    android:text="Stripe POS"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mainStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="Ready"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/mainBackendText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/testingConfigurationButton"
                    style="@style/StripePosButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Testing and Configuration"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/reportingButton"
                    style="@style/StripePosButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reporting"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/takePaymentButton"
                    style="@style/StripePosButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Take Payment"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/cartButton"
                    style="@style/StripePosButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cart (0)"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/recentTransactionsButton"
                    style="@style/StripePosButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recent App Transactions"
                    android:textAllCaps="false" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
