    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mainMenuContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/mainMenuTitle"
                android:layout_width="wrap_content"
                android:layout_height="151dp"
                android:fontFamily="sans-serif-black"
                android:paddingBottom="20dp"
                android:text="Stripe Payments"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="50sp"
                android:textStyle="bold"
                android:typeface="serif" />

            <TextView
                android:id="@+id/mainStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="Ready"
                android:textColor="#000000"
                android:textSize="16sp" />

            <Button
                android:id="@+id/takePaymentButton"
                style="@style/StripePosButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:text="Take Payment"
                android:textAllCaps="true"
                android:textSize="20sp" />

            <Button
                android:id="@+id/cartButton"
                style="@style/StripePosButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cart (0)"
                android:textAllCaps="true"
                android:textSize="20sp" />

            <Button
                android:id="@+id/reportingButton"
                style="@style/StripePosButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reporting"
                android:textAllCaps="true"
                android:textSize="20sp" />

            <Button
                android:id="@+id/recentTransactionsButton"
                style="@style/StripePosButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recent App Transactions"
                android:textAllCaps="true"
                android:textSize="20sp" />

            <Button
                android:id="@+id/testingConfigurationButton"
                style="@style/StripePosButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Testing and Configuration"
                android:textAllCaps="true"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/mainBackendText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>
    <!--
        </LinearLayout>
    -->
</FrameLayout>
