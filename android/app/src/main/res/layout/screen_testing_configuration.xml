<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA"
    android:paddingStart="7dp"
    android:paddingTop="8dp"
    android:paddingEnd="7dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_border"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="42dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/testingContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/testingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="20dp"
                    android:text="Testing and Configuration"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <Button
                    style="@style/StripePosButton"
                    android:id="@+id/testingBackButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Back to Main Screen"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/testingSimulatedReaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/testingStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="Ready"
                    android:textColor="#1C2632"
                    android:maxLines="6"
                    android:textSize="16sp" />

                <Button
                    style="@style/StripePosButton"
                    android:id="@+id/checkHealthButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check Health"
                    android:textAllCaps="false" />

                <Button
                    style="@style/StripePosButton"
                    android:id="@+id/testConnectionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test Connection Endpoint"
                    android:textAllCaps="false" />

                <Button
                    style="@style/StripePosButton"
                    android:id="@+id/testCardPresentButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test Card-Present Intent Endpoint"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/readerSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="28dp"
                    android:paddingBottom="8dp"
                    android:text="Reader"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connectedReaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selection_panel"
                    android:paddingStart="24dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="18dp"
                    android:textColor="#1C2632"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    style="@style/StripePosButton"
                    android:id="@+id/disconnectReaderButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disconnect Reader"
                    android:textAllCaps="false" />

                <Button
                    style="@style/StripePosButton"
                    android:id="@+id/initializeTerminalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Initialize Terminal"
                    android:textAllCaps="false" />

                <Button
                    style="@style/StripePosButton"
                    android:id="@+id/discoverReadersButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Discover Bluetooth Readers"
                    android:textAllCaps="false" />

                <ListView
                    android:id="@+id/readersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
