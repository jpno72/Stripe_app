<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:paddingStart="7dp"
    android:paddingTop="8dp"
    android:paddingEnd="7dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_border"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="18dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/testingContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/testingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingBottom="20dp"
                    android:text="Testing and Configuration"
                    android:textAlignment="center"
                    android:textColor="#182235"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/testingBackButton"
                        style="@style/StripePosButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:minHeight="72dp"
                        android:text="Back Home"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/testingSimulatedReaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:textColor="#617084"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/checkHealthButton"
                        style="@style/StripePosButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:minHeight="72dp"
                        android:text="Health"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/testConnectionButton"
                        style="@style/StripePosButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:minHeight="72dp"
                        android:text="Connection"
                        android:textAllCaps="false"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/testCardPresentButton"
                        style="@style/StripePosButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:minHeight="72dp"
                        android:text="Card Test"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/initializeTerminalButton"
                        style="@style/StripePosButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:minHeight="72dp"
                        android:text="Initialize"
                        android:textAllCaps="false"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/readerSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:text="Reader"
                    android:textColor="#182235"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connectedReaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selection_panel"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:textColor="#243247"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/discoverReadersButton"
                        style="@style/StripePosButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:minHeight="72dp"
                        android:text="Discover"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/disconnectReaderButton"
                        style="@style/StripePosButton"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:minHeight="72dp"
                        android:text="Disconnect"
                        android:textAllCaps="false"
                        android:textSize="13sp" />
                </LinearLayout>

                <ListView
                    android:id="@+id/readersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/testingStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/status_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/testingStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:text=""
                android:textColor="#243247"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
