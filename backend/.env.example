NODE_ENV=development
PORT=3000
APP_NAME=Internal Stripe POS Backend
DEFAULT_CURRENCY=usd
PERSISTENCE_MODE=stripe
LOCAL_STRIPE_MOCK_MODE=false
MEMBERSHIP_PLANS_JSON=[{"id":"basic","name":"Basic Membership","stripePriceId":"price_replace_basic","description":"Entry-level recurring membership"},{"id":"unlimited","name":"Unlimited Membership","stripePriceId":"price_replace_unlimited","description":"Unlimited recurring membership"}]

# Internal API bearer token used by Android/web dashboard clients.
API_TOKEN=replace_me

# Stripe
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_API_VERSION=2026-02-25.clover

# Optional MySQL/MariaDB persistence. Required only when PERSISTENCE_MODE=database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=replace_me
DB_PASSWORD=replace_me
DB_NAME=stripe_pos
DB_CONNECTION_LIMIT=10
